rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId &&
             !exists(/databases/$(database)/documents/deletionRequests/$(userId));
    }
    
    function isValidString(value, minLen, maxLen) {
      return value is string && value.size() >= minLen && value.size() <= maxLen;
    }
    
    function isValidNumber(value) {
      return value is number && value >= 0;
    }

    function isValidPhysicalProfile(data) {
      return data.keys().hasOnly([
               'peso', 'altura', 'edad', 'sexo', 'nivelActividad', 'objetivo',
               'pesoObjetivo', 'enfoque', 'fechaCreacion', 'lastUpdate'
             ]) &&
             (!('peso' in data) || (data.peso is number && data.peso > 0 && data.peso < 500)) &&
             (!('altura' in data) || (data.altura is number && data.altura > 0 && data.altura < 300)) &&
             (!('edad' in data) || (data.edad is number && data.edad >= 1 && data.edad <= 120)) &&
             (!('sexo' in data) || data.sexo in ['hombre', 'mujer']) &&
             (!('nivelActividad' in data) || data.nivelActividad in [
               'sedentario', 'ligero', 'moderado', 'activo', 'muy-activo', 'intenso', 'muy-intenso'
             ]) &&
             (!('objetivo' in data) || data.objetivo in [
               'perdida-grasa', 'mantenimiento', 'ganancia-musculo', 'ganancia-muscular'
             ]) &&
             (!('pesoObjetivo' in data) || (data.pesoObjetivo is number && data.pesoObjetivo > 0 && data.pesoObjetivo < 500)) &&
             (!('enfoque' in data) || data.enfoque is string) &&
             (!('fechaCreacion' in data) || data.fechaCreacion is string) &&
             (!('lastUpdate' in data) || data.lastUpdate is timestamp);
    }

    function isValidDailyHealth(data) {
      return data.keys().hasOnly([
               'fecha', 'bateria', 'agua', 'animo', 'ejercicioMinutos', 'comidas',
               'habitosChecks', 'suenoHoras', 'calidadSueno', 'estres',
               'recuperacionTiempoEstimado', 'prediccionBateriaManana', 'alertasNutricionales',
               'consejosIA', 'alimentos', 'caloriasTotales', 'proteinaTotal',
               'carbohidratosTotal', 'grasasTotal', 'vitaminasConsumo', 'mineralesConsumo',
               'indiceInflamatorioPromedio', 'deficitCalorico', 'ayunoInicio', 'lastUpdate'
             ]) &&
             (!('fecha' in data) || data.fecha is string) &&
             (!('bateria' in data) || (data.bateria is number && data.bateria >= 0 && data.bateria <= 100)) &&
             (!('agua' in data) || (data.agua is number && data.agua >= 0 && data.agua <= 20)) &&
             (!('animo' in data) || data.animo in ['mal', 'normal', 'genial']) &&
             (!('ejercicioMinutos' in data) || (data.ejercicioMinutos is number && data.ejercicioMinutos >= 0 && data.ejercicioMinutos <= 1440)) &&
             (!('habitosChecks' in data) || data.habitosChecks is list) &&
             (!('suenoHoras' in data) || (data.suenoHoras is number && data.suenoHoras >= 0 && data.suenoHoras <= 24)) &&
             (!('estres' in data) || (data.estres is number && data.estres >= 0 && data.estres <= 100)) &&
             (!('calidadSueno' in data) || data.calidadSueno in ['mala', 'regular', 'buena', 'excelente']) &&
             (!('alimentos' in data) || data.alimentos is list) &&
             (!('alertasNutricionales' in data) || data.alertasNutricionales is list) &&
             (!('consejosIA' in data) || data.consejosIA is list) &&
             (!('ayunoInicio' in data) || data.ayunoInicio == null || data.ayunoInicio is number) &&
             (!('lastUpdate' in data) || data.lastUpdate is timestamp);
    }

    function isValidHabit(data) {
      return data.keys().hasOnly([
               'nombre', 'frecuencia', 'iconType', 'activo', 'archivedAt', 'timestamp', 'createdAt'
             ]) &&
             isValidString(data.nombre, 1, 100) &&
             data.frecuencia in ['Diario', 'Semanal', 'Mensual'] &&
             isValidString(data.iconType, 1, 50) &&
             (!('activo' in data) || data.activo is bool) &&
             (!('archivedAt' in data) || data.archivedAt == null || data.archivedAt is timestamp) &&
             (!('timestamp' in data) || data.timestamp is timestamp) &&
             (!('createdAt' in data) || data.createdAt is timestamp);
    }
    
    // Users collection - solo el dueño puede leer/escribir
    match /users/{userId} {
      allow read: if isOwner(userId);
      // Modo demo: el usuario puede elegir free/pro para probar la interfaz.
      allow create: if isOwner(userId) &&
                      request.resource.data.keys().hasAll(['name', 'email', 'plan']) &&
                      request.resource.data.keys().hasOnly(['name', 'email', 'plan', 'isNew', 'createdAt']) &&
                      isValidString(request.resource.data.name, 1, 100) &&
                      request.resource.data.email == request.auth.token.email &&
                      request.resource.data.plan in ['free', 'pro'];
      // - plan solo puede ser 'free' o 'pro'
      // - email no puede divergir del que ya está guardado
      // NOTA antes de cobrar de verdad: congelar plan con
      //   request.resource.data.plan == resource.data.plan
      // y gestionarlo solo desde backend/webhook de pagos. Hoy el toggle
      // "Subir a Pro" del cliente es un modo de pruebas intencional.
      allow update: if isOwner(userId) &&
                      request.resource.data.keys().hasAll(['name', 'plan']) &&
                      request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                        'name', 'plan', 'isNew', 'physicalProfile', 'hasCompletedOnboarding',
                        'onboardingDate', 'stats', 'onboardingFocus', 'photoURL', 'photoPath'
                      ]) &&
                      isValidString(request.resource.data.name, 1, 100) &&
                      request.resource.data.plan in ['free', 'pro'] &&
                      (!resource.data.keys().hasAny(['email']) ||
                        (request.resource.data.keys().hasAny(['email']) && request.resource.data.email == resource.data.email));
      allow delete: if isOwner(userId);
      
      // Subcollections - solo el dueño puede acceder
      match /cuentas/{cuentaId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) &&
                        request.resource.data.keys().hasOnly(['nombre', 'monto', 'timestamp']) &&
                        isValidString(request.resource.data.nombre, 1, 100) &&
                        isValidNumber(request.resource.data.monto);
        // El saldo puede quedar negativo (sobregiro), pero debe ser número.
        // request.resource.data es el doc FINAL, así que cubre increment().
        allow update: if isOwner(userId) &&
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nombre', 'monto']) &&
                        request.resource.data.monto is number;
        allow delete: if isOwner(userId);
      }

      match /movimientos/{movimientoId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) &&
                        request.resource.data.keys().hasOnly([
                          'nombre', 'monto', 'tipo', 'categoria', 'cuentaId', 'cuentaDestinoId',
                          'cuentaNombre', 'ventaRefId', 'metaId', 'tarjetaId', 'tarjetaNombre', 'medioPago', 'timestamp'
                        ]) &&
                        isValidString(request.resource.data.nombre, 1, 200) &&
                        isValidNumber(request.resource.data.monto) &&
                        request.resource.data.tipo in ['INGRESO', 'GASTO', 'TRANSFERENCIA', 'AHORRO_META'] &&
                        !('tarjetaId' in request.resource.data) &&
                        !('tarjetaNombre' in request.resource.data) &&
                        !('medioPago' in request.resource.data);
        // Los movimientos manuales son editables; el importe de una venta se conserva.
        allow update: if isOwner(userId) &&
                        (
                          (!('ventaRefId' in resource.data) &&
                           resource.data.tipo in ['INGRESO', 'GASTO'] &&
                           request.resource.data.tipo in ['INGRESO', 'GASTO'] &&
                           isValidString(request.resource.data.nombre, 1, 200) &&
                           isValidNumber(request.resource.data.monto) &&
                           request.resource.data.monto > 0 &&
                           request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                             'nombre', 'cuentaId', 'cuentaNombre', 'monto', 'tipo', 'categoria', 'timestamp'
                           ])) ||
                          ('ventaRefId' in resource.data &&
                           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nombre', 'cuentaId', 'cuentaNombre']))
                        );
        allow delete: if isOwner(userId);
      }

      match /productos/{productoId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) &&
                        request.resource.data.keys().hasOnly(['nombre', 'precioVenta', 'costo', 'stock', 'timestamp']) &&
                        isValidString(request.resource.data.nombre, 1, 100) &&
                        isValidNumber(request.resource.data.precioVenta) &&
                        isValidNumber(request.resource.data.costo) &&
                        isValidNumber(request.resource.data.stock);
        allow update: if isOwner(userId) &&
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nombre', 'precioVenta', 'costo', 'stock']) &&
                        isValidNumber(request.resource.data.precioVenta) &&
                        isValidNumber(request.resource.data.costo) &&
                        isValidNumber(request.resource.data.stock);
        allow delete: if isOwner(userId);
      }
      
      match /ventas/{ventaId} {
        allow read: if isOwner(userId);
        // Las ventas nuevas solo se crean desde la API segura de Vercel (Admin SDK).
        allow create: if false;
        allow update: if isOwner(userId) &&
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cliente', 'cuentaId']) &&
                        isValidString(request.resource.data.cliente, 1, 100);
        allow delete: if isOwner(userId);
      }

      match /tarjetas/{tarjetaId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) &&
                        request.resource.data.keys().hasOnly(['nombre', 'banco', 'limite', 'saldo', 'timestamp']) &&
                        isValidString(request.resource.data.nombre, 1, 100) &&
                        isValidNumber(request.resource.data.limite) &&
                        isValidNumber(request.resource.data.saldo);
        allow update: if isOwner(userId) &&
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nombre', 'banco', 'limite', 'saldo']) &&
                        request.resource.data.limite is number &&
                        request.resource.data.saldo is number;
        allow delete: if isOwner(userId);
      }
      
      match /fijos/{fijoId} {
        allow read, delete: if isOwner(userId);
        allow update: if isOwner(userId) &&
                      request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                        'nombre', 'monto', 'periodicidad', 'diaCobro', 'cuentaId'
                      ]) &&
                      isValidString(request.resource.data.nombre, 1, 100) &&
                      isValidNumber(request.resource.data.monto);
        allow create: if isOwner(userId) && 
                        request.resource.data.keys().hasOnly(['nombre', 'monto', 'periodicidad', 'diaCobro', 'cuentaId', 'timestamp']) &&
                        isValidString(request.resource.data.nombre, 1, 100) &&
                        isValidNumber(request.resource.data.monto);
      }
      
      match /metas/{metaId} {
        allow read, update, delete: if isOwner(userId);
        allow create: if isOwner(userId) && 
                        request.resource.data.keys().hasOnly(['nombre', 'montoObjetivo', 'montoActual', 'timestamp']) &&
                        isValidString(request.resource.data.nombre, 1, 100) &&
                        isValidNumber(request.resource.data.montoObjetivo);
      }
      
      match /presupuestos/{presupuestoId} {
        allow read, delete: if isOwner(userId);
        allow create: if isOwner(userId) &&
                        request.resource.data.keys().hasOnly([
                          'categoria', 'limite', 'historial', 'alertas', 'ultimaActualizacion', 'timestamp'
                        ]) && isValidNumber(request.resource.data.limite);
        allow update: if isOwner(userId) &&
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                          'categoria', 'limite', 'historial', 'alertas', 'ultimaActualizacion'
                        ]) && isValidNumber(request.resource.data.limite);
      }
      
      match /habitos/{habitoId} {
        allow read: if isOwner(userId);
        allow update: if isOwner(userId) && isValidHabit(request.resource.data) &&
                      request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                        'nombre', 'frecuencia', 'iconType', 'activo', 'archivedAt', 'timestamp', 'createdAt'
                      ]);
        allow create: if isOwner(userId) && 
                        isValidHabit(request.resource.data);
        allow delete: if false;
      }
      
      match /peso/{pesoId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && 
                        isValidNumber(request.resource.data.peso) &&
                        request.resource.data.peso > 0 &&
                        request.resource.data.peso < 500;
        allow delete: if isOwner(userId);
      }
      
      match /salud/{saludId} {
        allow read, write: if isOwner(userId);
      }

      // El código usa 'salud_diaria' (un doc por fecha)
      match /salud_diaria/{saludId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidDailyHealth(request.resource.data);
      }

      match /perfilFisico/{perfilId} {
        allow read: if isOwner(userId) && perfilId == 'config';
        allow create, update: if isOwner(userId) && perfilId == 'config' && isValidPhysicalProfile(request.resource.data);
      }

      match /pet/{petId} {
        allow read, write: if isOwner(userId);
      }

      // Contador de recibos: solo la API de Vercel (Admin SDK) puede acceder.
      match /counters/{counterId} {
        allow read, write: if false;
      }
    }
    
    // Denegar acceso a todo lo demás
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
